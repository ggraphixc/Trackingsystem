# TrackNaija sync server — environment template.
# Copy to .env (or set in your host's dashboard) and fill in what you use.

# --- Storage (dual-mode) ------------------------------------------------
# Unset to keep using the local JSON file (data.json). Set to a Neon
# connection string to persist to hosted Postgres instead:
#   DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# (Neon: https://console.neon.tech → Connection Details → connection string)

# --- Web push (auto-generated VAPID keys, no config needed) ------------
# Keys are created on first boot and persisted in the store.

# --- SMS fallback alerts (pick ONE provider) ----------------------------
# Twilio — https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Termii (Nigeria-native, DND-friendly) — https://termii.com
TERMII_API_KEY=
TERMII_FROM=
# Owner number can also be set from the dashboard (Agents page → SMS alerts).

# --- Server --------------------------------------------------------------
PORT=4173
# Bind 0.0.0.0 when deploying (Render/Fly) so the host can reach the server.
HOST=127.0.0.1
